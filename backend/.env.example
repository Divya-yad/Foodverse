# Copy to .env (never commit .env). Used by docker-compose and by the backend when run locally.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Generate with:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
ENVIRONMENT=development          # set to "production" to enforce a strong JWT_SECRET
COOKIE_SECURE=false              # true when served over HTTPS

POSTGRES_USER=foodverse
POSTGRES_PASSWORD=change-this-password
POSTGRES_DB=foodverse
APP_PORT=8080
